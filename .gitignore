# ==============================================================================
# Root .gitignore - College Event Management System
# ==============================================================================

# Environment files and secrets (NEVER commit to Git)
.env
.env.local
.env.*.local
*.env
application-local.properties
application-prod.properties
*.pem
*.key
*.cert
secrets/

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# IDE & Editor Files
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln

# Maven Build Artifacts (Backend)
backend/target/
**/target/
*.class

# Node & Frontend Build Artifacts
frontend/node_modules/
**/node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Crash & Local Logs
logs/
*.log
