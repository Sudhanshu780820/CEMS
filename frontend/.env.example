# ==============================================================================
# Frontend Environment Configuration
# ==============================================================================
# For Local Development:
# Leave blank to use Vite's internal development proxy (/api -> localhost:8080)
# OR specify:
# VITE_API_BASE_URL=http://localhost:8080
#
# For Production Deployment (Vercel, Netlify, Render Static Site, etc.):
# Set this in your cloud provider's Environment Variables dashboard:
# VITE_API_BASE_URL=https://your-backend-app.onrender.com
# ==============================================================================
VITE_API_BASE_URL=http://localhost:8080
